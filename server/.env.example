# Backend only. Copy to server/.env and fill these locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SNOOZE_SIGNING_SECRET=
# For a phone on your private Wi-Fi, use HOST=0.0.0.0.
HOST=127.0.0.1
PORT=8787
# Only needed for a browser client; set its exact origin, never a wildcard.
SNOOZE_ALLOWED_ORIGIN=
